# Copie para .env. Em dev, `npm run dev` já sobe um Postgres local e preenche DATABASE_URL.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/atende_ai
PORT=3100
# Origens do painel admin liberadas no CORS, separadas por vírgula.
CORS_ORIGENS=http://localhost:5173

# Qual IA responde o chat:
#   simulado  -> resposta de mentira, custo zero (padrão)
#   ollama    -> IA local e gratuita (https://ollama.com), precisa do Ollama aberto
#   anthropic -> Claude, pela API paga da Anthropic (precisa de ANTHROPIC_API_KEY)
IA_PROVEDOR=simulado

OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen3:8b

ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_ESFORCO=low
