{
  "name": "atende-ai-api",
  "version": "0.0.1",
  "description": "API do Atende AI: chatbot com IA para empresas. NestJS + PostgreSQL + Claude.",
  "author": "Claudio Alvarenga",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:prod": "node --env-file-if-exists=.env dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verificar": "npm run typecheck && npm run lint && npm test && npm run build",
    "e2e": "node scripts/e2e-painel.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/typeorm": "^12.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
